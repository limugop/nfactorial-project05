# Образец настроек проекта «Спасти хакатон». Копия этого файла под именем .env
# заполняется своими ключами, сам .env в git не попадает.

# Провайдер модели: openai, ollama или hf
MODEL_PROVIDER=openai

# openai: ключ создаётся на platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ollama: локальная модель, ключ не нужен, модель скачивается командой ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b

# hf: открытая модель через Hugging Face Inference Providers, токен создаётся
# на huggingface.co/settings/tokens с правом Make calls to Inference Providers
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# Трассировка в Langfuse (необязательно при локальном журнале journal.jsonl)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
